      "$value": "Arial, sans-serif",
      "$extensions": {
        "dfs": {
          "ref": "a:f3"
        }
      }
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(0, 0, 0, 0.1)",
