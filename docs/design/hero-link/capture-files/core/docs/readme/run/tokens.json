          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 16,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        },
        "inset": false
      },
      "$extensions": {
        "dfs": {
          "ref": "a:sh1"
        }
      }
    }
  },
  "spacing": {
    "1": {
