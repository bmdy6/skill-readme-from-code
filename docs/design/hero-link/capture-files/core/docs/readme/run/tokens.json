{
  "color": {
    "text": {
      "$type": "color",
      "$value": "#172033",
      "$extensions": {
        "dfs": {
          "ref": "a:c1"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "dfs": {
          "ref": "a:c2"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "#dde1e8",
      "$extensions": {
        "dfs": {
          "ref": "a:c3"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#2564eb",
      "$extensions": {
        "dfs": {
          "ref": "a:c6"
        }
      }
    },
    "subtle": {
      "$type": "color",
      "$value": "#eef2fa",
      "$extensions": {
        "dfs": {
          "ref": "a:c5"
        }
      }
    }
  },
  "fontFamily": {
    "body": {
